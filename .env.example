# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Supabase → Project Settings → Database → Connection string → URI.
# Use the pooled connection string for a deployed app.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/afterglow

# ---------------------------------------------------------------------------
# Supabase Auth and Storage
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_* values reach the browser by design. The anon key is safe to
# publish: every table it can address is behind row level security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-the-publishable-anon-key

# No service-role key is needed. Every request runs as the signed-in account so
# row level security applies, and the legacy migration script connects through
# DATABASE_URL. If you ever add one, keep it server-side and never prefix it
# with NEXT_PUBLIC_ — it bypasses row level security completely.

# ---------------------------------------------------------------------------
# Model provider (server-side only)
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=replace-me
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Default model for new accounts.
DEEPSEEK_MODEL=deepseek-v4-flash
# Optional experimental OpenRouter provider. Both values are server-only.
ENABLE_OPENROUTER=false
OPENROUTER_API_KEY=replace-with-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=Afterglow
# Optional public deployment URL sent to OpenRouter as HTTP-Referer.
# OPENROUTER_SITE_URL=https://afterglow.example
# Provider and Afterglow RP engine defaults for newly created conversations.
# Existing conversations persist their own selection and are not rewritten.
DEFAULT_LLM_PROVIDER=deepseek
# Optional catalog model id when DEFAULT_LLM_PROVIDER is not DeepSeek.
# DEFAULT_LLM_MODEL=kimi-k2.5
DEFAULT_RP_ENGINE=immersive
# Which models an account may select. Anything outside this list is rejected
# server-side, so a user cannot pick a model you do not want to pay for.
ALLOWED_MODELS=deepseek-v4-flash,deepseek-v4-pro
# OpenRouter writers, once ENABLE_OPENROUTER=true. The MiMo pair are Xiaomi's
# MiMo V2.5 and V2.5 Pro; they are separate models and neither substitutes for
# the other. Midnight Cherry reads only 32,768 tokens, so a story with a large
# World attached is refused with an actionable message rather than a 400.
# ALLOWED_MODELS=deepseek-v4-flash,mimo-v2.5,mimo-v2.5-pro,midnight-cherry

# BENCHMARKING ONLY. Pins one catalogue model to one upstream endpoint so it can
# be compared against the alternatives — for example Xiaomi's own MiMo endpoint
# against the others. Production must not set this: a pin means one provider's
# outage takes that model down. Format: model:provider, comma separated.
# PIN_UPSTREAM_PROVIDER=mimo-v2.5:xiaomi

# Where the per-turn continuity block sits in the writer prompt.
#
#   tail   (default on models that support prompt caching) — the changing half
#          is delivered just before the turn being answered, so the system
#          prompt AND the whole transcript stay byte-identical between turns and
#          a provider can reuse them. Measured on a representative long story:
#          reusable prefix 49.4% -> 82.0%, with the first divergence moving from
#          the rolling summary to the newly added turns.
#   system (default on models that do not cache) — one system message carrying
#          both halves. Byte-identical to Afterglow's pre-2026-08 prompt.
#
# Set this explicitly to override both defaults. It is a kill switch: the tail
# layout changes the prompt of every ongoing conversation on a caching model,
# and putting it back must not require a deploy.
# PROMPT_CONTINUITY_PLACEMENT=system

# Background JSON/maintenance jobs do not follow the conversation's RP writer.
# Values use provider:catalog-model-id. These defaults preserve DeepSeek.
RP_MODEL_ROUTE=conversation
MEMORY_CONSOLIDATION_MODEL_ROUTE=deepseek:deepseek-v4-flash
MEMORY_CURATION_MODEL_ROUTE=deepseek:deepseek-v4-flash
# Powers both creation accelerators — Quick Idea and Paste Everything. The
# task is structured extraction with reliable instruction following, not
# roleplay writing, so it deliberately does not use the conversation's RP
# model. Usage is recorded per behaviour (creation_quick_idea, creation_import
# and creation_import_inventory) under this one route.
CHARACTER_IMPORT_MODEL_ROUTE=deepseek:deepseek-v4-flash

# Memory Retrieval V2 is fail-closed. Apply migration 0006, enable it, and put
# only test-account UUIDs in the allowlist. Do not set ALL_USERS during beta.
MEMORY_RETRIEVAL_V2_ENABLED=false
MEMORY_RETRIEVAL_V2_USER_IDS=
MEMORY_RETRIEVAL_V2_ALL_USERS=false
# Comma-separated Supabase account UUIDs allowed to use memory diagnostics,
# continuity tuning, manual consolidation, and the full usage ledger.
AFTERGLOW_ADMIN_USER_IDS=
MEMORY_SEMANTIC_ENABLED=true
MEMORY_EMBEDDING_MODEL=qwen/qwen3-embedding-8b
MEMORY_EMBEDDING_DIMENSIONS=1024
MEMORY_CANON_TOKEN_BUDGET=1200
MEMORY_CURATION_INTERVAL_MESSAGES=100

# Scene State (temporal/spatial grounding) is fail-closed and independent of
# Memory Retrieval V2, so a conversation can be compared with it on and off
# without changing which memories are retrieved. Apply migration 0013 first,
# then list only test-account UUIDs. Do not set ALL_USERS during beta.
SCENE_STATE_ENABLED=false
SCENE_STATE_USER_IDS=
SCENE_STATE_ALL_USERS=false
# Extraction runs in the background after a reply; it never uses the RP writer.
SCENE_STATE_MODEL_ROUTE=deepseek:deepseek-v4-flash
# Lets the current scene's people and place join the retrieval query. Off by
# default: Scene State exists to interpret retrieved memories, not to select
# them, and any ranking effect has to be measured on its own.
SCENE_STATE_RETRIEVAL_HINT_ENABLED=false

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Display name applied to the legacy owner during data migration.
OWNER_NAME=You

# ---------------------------------------------------------------------------
# Tests
# ---------------------------------------------------------------------------
# A throwaway PostgreSQL for the row level security suite. When unset those
# tests skip; everything else still runs.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/afterglow_test
